# Porta HTTP (Render injeta automaticamente; default 3000 em dev)
PORT=3000

# String de conexão do MongoDB. Se NÃO definida, o backend usa armazenamento
# em arquivo JSON (modo desenvolvimento). Em produção, defina com sua URI do
# MongoDB Atlas. NUNCA commite a URI real — configure como secret na plataforma.
# MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/?retryWrites=true&w=majority

# Nome do banco de dados usado no MongoDB (default: analytics)
MONGODB_DB=analytics

# Limite de requisições por IP por minuto (default: 60)
RATE_LIMIT_PER_MINUTE=60

# Máximo de registros por coleção/arquivo; ao atingir, novos POSTs recebem 507
# (default: 10000)
MAX_RECORDS_PER_FILE=10000
